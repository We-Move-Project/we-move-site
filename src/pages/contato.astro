---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LeadForm from "@/components/LeadForm.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";

const faqItems = [
  {
    question: "Quanto custa o We Move?",
    answer: "O valor é uma mensalidade que depende do número de rotas e estudantes atendidos, paga pelo operador de transporte. Fazemos uma proposta sob medida após entender sua operação — agende uma apresentação e montamos um orçamento sem compromisso.",
  },
  {
    question: "Quanto tempo leva para implantar?",
    answer: "A maioria das operações entra no ar em 2 a 4 semanas. Ajudamos no cadastro das rotas, treinamos os motoristas e acompanhamos as primeiras viagens de perto.",
  },
  {
    question: "Preciso trocar minha frota ou meus motoristas?",
    answer: "Não. O We Move funciona com a operação que você já tem. O motorista usa o próprio celular e o operador mantém seus veículos e contratos.",
  },
  {
    question: "O estudante paga alguma coisa para usar o app?",
    answer: "Não. O app é totalmente gratuito para o estudante. O We Move funciona por uma mensalidade paga pelo operador de transporte de cada cidade — nunca por cobrança ao aluno.",
  },
  {
    question: "Funciona para rotas intermunicipais?",
    answer: "Sim — foi exatamente aí que começamos. O We Move é feito para trajetos longos entre cidades e o campus, como as rotas do interior do Ceará.",
  },
  {
    question: "Como o We Move gera receita?",
    answer: "Por uma mensalidade paga pelo operador de transporte de cada cidade, conforme o tamanho da operação. O estudante não paga nada pela plataforma.",
  },
];
---

<BaseLayout
  title="Contato"
  description="Fale com a gente ou agende uma apresentação gratuita do We Move. Veja também nossas perguntas frequentes."
>
  <section class="page-hero">
    <div class="container">
      <div class="reveal" style="max-width:720px">
        <span class="eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m3 6 9 7 9-7"/></svg> Contato</span>
        <h1>Vamos conversar sobre o transporte da sua instituição</h1>
        <p class="lead">Escolha o caminho mais rápido: fale com a gente agora ou agende uma apresentação completa da plataforma.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-2" style="align-items:start">
        <div class="reveal" id="mensagem" style="scroll-margin-top:100px">
          <h2 class="h3" style="margin-bottom:6px">Fale com a gente</h2>
          <p class="muted" style="margin-bottom:22px">Tem uma dúvida ou quer entender se o We Move serve para você? Escreva pra gente.</p>
          <LeadForm type="contact" />
        </div>

        <div class="reveal" id="agendar" style="scroll-margin-top:100px">
          <h2 class="h3" style="margin-bottom:6px">Agendar uma apresentação</h2>
          <p class="muted" style="margin-bottom:22px">Uma demonstração de 30 minutos com as rotas da sua instituição. Gratuita e sem compromisso.</p>
          <LeadForm type="presentation_request" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section-sunken" id="faq" style="scroll-margin-top:90px">
    <div class="container" style="max-width:820px">
      <div class="section-head center reveal">
        <span class="eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/></svg> Perguntas frequentes</span>
        <h2 class="h2">FAQ</h2>
        <p class="lead">As dúvidas que mais recebemos de contratantes.</p>
      </div>
      <div class="reveal">
        <FaqAccordion items={faqItems} />
      </div>
    </div>
  </section>
</BaseLayout>
