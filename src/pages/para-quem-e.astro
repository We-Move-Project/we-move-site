---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ImageSlot from "@/components/ImageSlot.astro";

const audiences = [
  {
    tag: "Universidades",
    tagClass: "",
    icon: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 8h.01M15 8h.01M9 12h.01M15 12h.01M9 16h6"/>',
    title: "Universidades e faculdades",
    pain: "Alunos faltam ou chegam atrasados por transporte incerto, e a instituição não tem visibilidade nem canal de comunicação.",
    solution: "Rotas confiáveis, comunicados oficiais no app e dados de frequência que ajudam a reduzir a evasão.",
    cta: "Quero para minha instituição",
  },
  {
    tag: "Operadores",
    tagClass: "orange",
    icon: '<rect x="4" y="3" width="16" height="14" rx="3"/><path d="M4 10h16"/><path d="M7 17v2M17 17v2"/><circle cx="8" cy="13.5" r="1"/><circle cx="16" cy="13.5" r="1"/>',
    title: "Empresas de transporte terceirizadas",
    pain: "Gestão manual de rotas, controle em planilhas e dificuldade de comprovar pontualidade para o contratante.",
    solution: "Painel de operação, gestão centralizada de rotas e relatórios que provam a qualidade do serviço.",
    cta: "Quero digitalizar minha operação",
  },
  {
    tag: "Estudantes",
    tagClass: "success",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11"/>',
    title: "Associações e DAs estudantis",
    pain: "Organizar caravanas e transporte por grupos de WhatsApp é caótico — listas soltas, comunicação confusa e zero rastreio.",
    solution: "Cadastro de rotas coletivas, comunicação organizada e app que dá autonomia e segurança para cada estudante.",
    cta: "Quero organizar nosso transporte",
  },
];

const benefits = [
  "Estudante chega no horário e com tranquilidade",
  "Operador reduz custo com gestão manual",
  "Instituição melhora a experiência e a retenção",
  "Menos ruído, mais confiança entre as partes",
];
---

<BaseLayout
  title="Para quem é"
  description="O We Move atende universidades, empresas de transporte e associações estudantis — cada uma com sua dor resolvida."
>
  <section class="page-hero">
    <div class="container">
      <div class="reveal" style="max-width:720px">
        <span class="eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11"/></svg> Para quem é</span>
        <h1>Uma solução, três lados atendidos</h1>
        <p class="lead">O We Move resolve a dor de cada parte envolvida no transporte universitário — sem obrigar ninguém a mudar como trabalha.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        {audiences.map((audience) => (
          <div class="audience-card reveal">
            <span class={`tag ${audience.tagClass}`} set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${audience.icon}</svg> ${audience.tag}`} />
            <h3>{audience.title}</h3>
            <div class="audience-block">
              <div class="k">A dor</div>
              <p>{audience.pain}</p>
            </div>
            <div class="audience-block">
              <div class="k">Como resolvemos</div>
              <p>{audience.solution}</p>
            </div>
            <a class="btn btn-secondary btn-block" href="/contato#agendar" style="margin-top:auto">{audience.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="container">
      <div class="step-row" style="padding:0;border:none">
        <div class="step-media reveal">
          <ImageSlot placeholder="Foto: estudantes embarcando no ônibus" />
        </div>
        <div class="step-body reveal">
          <span class="eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg> Feito para o dia a dia real</span>
          <h3>Todos ganham quando o transporte funciona</h3>
          <ul>
            {benefits.map((benefit) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band reveal">
        <h2 class="h2">Pronto para transformar o transporte da sua instituição?</h2>
        <p>Agende uma apresentação gratuita e veja o We Move funcionando com as rotas da sua universidade.</p>
        <div class="btns">
          <a class="btn btn-lg btn-on-dark" href="/contato#agendar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
            Agendar apresentação
          </a>
          <a class="btn btn-lg btn-outline-light" href="/contato">Falar com a gente</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
